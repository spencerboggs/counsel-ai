# Backend
AI_COUNSEL_HOST=127.0.0.1
AI_COUNSEL_PORT=8000
AI_COUNSEL_CONFIG=config.yaml
AI_COUNSEL_DB_PATH=backend/data/ai_counsel.db

# Ollama (local LLM runtime)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional remote LLM providers — leave empty; disabled unless you set keys
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Trading (prefer Settings UI → Keys). Default is free local paper trading.
# Alpaca paper keys are free from https://alpaca.markets (paper account).
# Alpaca live keys spend real money — never set these unless you intend live trading.
# ALPACA_PAPER_KEY=
# ALPACA_PAPER_SECRET=
# ALPACA_LIVE_KEY=
# ALPACA_LIVE_SECRET=
